{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/avs/include",
                "${workspaceFolder}/src/pacc/include",
                "/opt/ros/jazzy/include/**",
                "/usr/include/**",
                "/usr/local/include/**",
                "/usr/include/opencv4",
                "/usr/include/eigen3",
                "/usr/include/yaml-cpp"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src/avs/include",
                    "${workspaceFolder}/src/pacc/include",
                    "/opt/ros/jazzy/include/**",
                    "/usr/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ],
    "version": 4
}